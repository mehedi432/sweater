 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n@page {\r\n    size: A4;\r\n    margin: 8mm;\r\n}\r\nbody{\r\n    margin:0;\r\n    padding:0;\r\n    -webkit-print-color-adjust:exact;\r\n    font-family:'Ubuntu Mono', monospace;\r\n}\r\n\r\n.main-grid{\r\n    display:grid;\r\n    grid-template-columns:2fr 1fr;\r\n    grid-template-rows:1fr 1fr;\r\n    gap:13px;\r\n    width:100%;\r\n    height:50%;\r\n    box-sizing:border-box;\r\n}\r\n\r\n.tag-container{\r\n    border:1.6px solid #111;\r\n    border-radius:13px;\r\n    padding:8px;\r\n    background:#fff;\r\n    display:flex;\r\n    flex-direction:column;\r\n    box-sizing:border-box;\r\n    overflow:hidden;\r\n}\r\n\r\n.big-tag{grid-row:span 2;padding:13px;}\r\n\r\n.header{\r\n    display:flex;\r\n    align-items:center;\r\n    justify-content:space-between;\r\n    margin-bottom:5px;\r\n    border-bottom:2px solid #111;\r\n    padding-bottom:5px;\r\n}\r\n\r\n.title-area{text-align:center;flex:1;}\r\n.big-tag .title{font-size:120%;font-weight:900;letter-spacing:1.6px;}\r\n.small-tag .title{font-size:11px;font-weight:900;}\r\n\r\n.content-area{flex-grow:1;display:flex;flex-direction:column;}\r\n\r\ntable{width:100%;border-collapse:collapse;table-layout:fixed;}\r\n.underline{border-bottom:1px solid #eee;}\r\n\r\n.lbl{font-weight:700;color:#555;text-transform:uppercase;width:35%;}\r\n.big-tag .lbl{font-size:11px;padding:4px 0;}\r\n.small-tag .lbl{font-size:7px;padding:1px 0;}\r\n\r\n.val{font-weight:800;color:#000;word-wrap:break-word;}\r\n.big-tag .val{font-size:13px;}\r\n.small-tag .val{font-size:8.5px;}\r\n\r\n.comp-val{line-height:1.1;}\r\n\r\n.qr-img{object-fit:contain;}\r\n.big-tag .qr-img{width:89px;height:89px;}\r\n.small-tag .qr-img{width:55px;height:55px;}\r\n\r\n.logo{object-fit:contain;}\r\n.big-tag .logo{width:70px;}\r\n.small-tag .logo{width:30px;}\r\n\r\n.footer{\r\n    display:flex;\r\n    justify-content:space-between;\r\n    align-items:center;\r\n    color:#444;\r\n    margin-top:3px;\r\n    padding-top:2px;\r\n    border-top:1px dashed #ccc;\r\n}\r\n\r\n.big-tag .footer{font-size:9px;}\r\n.small-tag .footer{font-size:7px;}\r\n\r\n</style>\r\n\r\n<!-- ================= YARN TOTAL CALCULATION ================= -->\r\n\r\n{% set yarn_totals = {} %}\r\n{% set grand_total = 0 %}\r\n\r\n{% for yarn in doc.raw_material %}\r\n\r\n{% set key = yarn.yarn_composition ~ \" \" ~ yarn.yarn_count ~ \" \" ~ yarn.colour %}\r\n\r\n{% if key in yarn_totals %}\r\n{% set _ = yarn_totals.update({key: yarn_totals[key] + (yarn.quantity or 0)}) %}\r\n{% else %}\r\n{% set _ = yarn_totals.update({key: (yarn.quantity or 0)}) %}\r\n{% endif %}\r\n\r\n{% set grand_total = grand_total + (yarn.quantity or 0) %}\r\n\r\n{% endfor %}\r\n\r\n<div class=\"main-grid\">\r\n\r\n<!-- ================= BIG TAG ================= -->\r\n\r\n<div class=\"tag-container big-tag\">\r\n\r\n<div class=\"header\">\r\n\r\n<img src=\"/files/logo_meek-01.png\" class=\"logo\">\r\n\r\n<div class=\"title-area\">\r\n<div class=\"title\">YARN TAG</div>\r\n</div>\r\n\r\n<img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&data={{ frappe.utils.get_url() }}/app/daily-sample-request/{{ doc.name }}\" class=\"qr-img\">\r\n\r\n</div>\r\n\r\n<div class=\"content-area\">\r\n\r\n<table>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">BUYER</td>\r\n<td class=\"val\">{{ doc.buyer or \"\" }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">STYLE</td>\r\n<td class=\"val\">{{ doc.style or \"\" }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">YARN DETAILS</td>\r\n<td class=\"val comp-val\">\r\n\r\n{% for k,v in yarn_totals.items() %}\r\n{{ k }} \u2014 {{ v }} KG <br>\r\n{% endfor %}\r\n\r\n</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">SSO NO</td>\r\n<td class=\"val\">{{ doc.sso_number }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">SDO NO</td>\r\n<td class=\"val\">{{ doc.sdo_number }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">LOT NO</td>\r\n<td class=\"val\"></td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">REMARKS</td>\r\n<td class=\"val\">{{ doc.remarks }}</td>\r\n</tr>\r\n\r\n<tr>\r\n<td class=\"lbl\">GRAND TOTAL</td>\r\n<td class=\"val\">{{ grand_total }} KG</td>\r\n</tr>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n<div class=\"footer\">\r\n\r\n<div>DATE: {{ frappe.utils.formatdate(frappe.utils.nowdate(),\"dd MMM yyyy\") }}</div>\r\n\r\n<div style=\"font-weight:bold;\">\r\nID: {{ doc.name }}\r\n</div>\r\n\r\n</div>\r\n\r\n<div style=\"font-weight:bold;margin-top:13px;text-align:center;font-size:10px;\">\r\nDESIGNER:\r\n{{ frappe.db.get_value(\"Employee\", doc.designer, \"employee_name\") | upper }}\r\n-\r\n{{ doc.designer }}\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- ================= SMALL TAGS ================= -->\r\n\r\n{% for i in range(2) %}\r\n\r\n<div class=\"tag-container small-tag\">\r\n\r\n<div class=\"header\">\r\n\r\n<img src=\"/files/logo_meek-01.png\" class=\"logo\">\r\n\r\n<div class=\"title-area\">\r\n<div class=\"title\">YARN TAG</div>\r\n</div>\r\n\r\n<img src=\"https://api.qrserver.com/v1/create-qr-code/?size=100x100&data={{ frappe.utils.get_url() }}/app/daily-sample-request/{{ doc.name }}\" class=\"qr-img\">\r\n\r\n</div>\r\n\r\n<div class=\"content-area\">\r\n\r\n<table>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">BUYER</td>\r\n<td class=\"val\">{{ (doc.buyer or \"\")[:34] }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">STYLE</td>\r\n<td class=\"val\">{{ (doc.style or \"\")[:34] }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">YARN</td>\r\n<td class=\"val comp-val\">\r\n\r\n{% for k,v in yarn_totals.items() %}\r\n{{ k }} ({{ v }}KG)<br>\r\n{% endfor %}\r\n\r\n</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">SSO</td>\r\n<td class=\"val\">{{ doc.sso_number }}</td>\r\n</tr>\r\n\r\n<tr class=\"underline\">\r\n<td class=\"lbl\">SDO</td>\r\n<td class=\"val\">{{ doc.sdo_number }}</td>\r\n</tr>\r\n\r\n<tr>\r\n<td class=\"lbl\">TOTAL</td>\r\n<td class=\"val\">{{ grand_total }} KG</td>\r\n</tr>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n<div class=\"footer\">\r\n\r\n<div style=\"font-weight:bold;\">\r\n{{ doc.name[-5:] }}\r\n</div>\r\n\r\n<div>\r\nDATE:\r\n{{ frappe.utils.formatdate(frappe.utils.nowdate(),\"dd MMM yyyy\") | upper }}\r\n</div>\r\n\r\n<div style=\"text-align:right;\">\r\n#{{ i + 1 }}\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n{% endfor %}\r\n\r\n</div>",
