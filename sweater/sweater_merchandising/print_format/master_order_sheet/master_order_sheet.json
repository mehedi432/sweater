er:1.5px solid var(--gold-light); border-radius:4px; padding:2px; background:var(--gold-pale);\">\n       </div>\n   </div>\n\n   <div style=\"height:3px; background:linear-gradient(90deg, var(--gold-light) 0%, var(--gold-stripe) 30%, var(--gold-bright) 60%, var(--gold-deep) 100%); border-radius:2px; margin-top:18px;\"></div>\n\n</div>\n{% endif %}\n{% endfor %}",
