{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-13 16:34:36.113894",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Order Sheet Entry",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n   @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');\n\n   * { box-sizing: border-box; margin: 0; padding: 0; }\n\n   .page-wrap {\n       font-family: 'Inter', sans-serif;\n       color: #1a2744;\n       line-height: 1.5;\n       max-width: 1020px;\n       margin: auto;\n       padding: 36px 32px;\n       background: #ffffff;\n       page-break-before: always;\n       page-break-inside: avoid;\n   }\n   .page-wrap:first-of-type { page-break-before: avoid; }\n\n   /* \u2500\u2500 GOLD PALETTE \u2500\u2500 */\n   :root {\n       --gold-deep:    #8B6914;\n       --gold-mid:     #B8902A;\n       --gold-bright:  #D4A843;\n       --gold-light:   #F0D080;\n       --gold-pale:    #FBF5E6;\n       --gold-stripe:  #E8C96A;\n       --navy-deep:    #0D1B3E;\n       --navy-mid:     #1A2D5A;\n       --navy-light:   #2B4080;\n       --navy-pale:    #EEF2FA;\n       --white:        #FFFFFF;\n       --border-gold:  #D4A843;\n       --border-navy:  #2B4080;\n       --text-dark:    #0D1B3E;\n       --text-mid:     #3A4F7A;\n       --text-muted:   #7A8BAA;\n   }\n\n   /* \u2500\u2500 HEADER \u2500\u2500 */\n   .doc-header {\n       display: flex;\n       justify-content: space-between;\n       align-items: flex-start;\n       margin-bottom: 22px;\n       padding-bottom: 18px;\n       border-bottom: 2px solid var(--gold-bright);\n       position: relative;\n   }\n   .doc-header::after {\n       content: '';\n       position: absolute;\n       bottom: -5px;\n       left: 0;\n       right: 0;\n       height: 1px;\n       background: var(--gold-light);\n   }\n   .title-block { display: flex; align-items: center; gap: 16px; }\n   .title-accent {\n       width: 4px;\n       height: 56px;\n       background: linear-gradient(180deg, var(--gold-bright) 0%, var(--gold-deep) 100%);\n       border-radius: 2px;\n       flex-shrink: 0;\n   }\n   .doc-title {\n       font-family: 'Playfair Display', serif;\n       font-size: 24px;\n       font-weight: 700;\n       color: var(--navy-deep);\n       letter-spacing: 0.5px;\n       line-height: 1.1;\n   }\n   .doc-subtitle {\n       font-size: 9px;\n       color: var(--gold-mid);\n       text-transform: uppercase;\n       letter-spacing: 2px;\n       font-weight: 600;\n       margin-top: 5px;\n   }\n   .doc-id-chip {\n       background: var(--navy-deep);\n       color: var(--gold-stripe);\n       padding: 3px 10px;\n       border-radius: 3px;\n       font-size: 9px;\n       font-weight: 700;\n       letter-spacing: 1px;\n       margin-top: 6px;\n       display: inline-block;\n   }\n   .badge-block { text-align: right; }\n   .supplier-badge {\n       background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy-light) 100%);\n       color: var(--gold-stripe);\n       padding: 7px 20px;\n       font-size: 8.5px;\n       font-weight: 700;\n       text-transform: uppercase;\n       letter-spacing: 1.5px;\n       border-radius: 4px;\n       border: 1px solid var(--gold-mid);\n       display: inline-block;\n   }\n   .sdo-text {\n       font-size: 9.5px;\n       color: var(--text-mid);\n       font-weight: 600;\n       margin-top: 7px;\n   }\n   .sdo-text span { color: var(--navy-deep); font-weight: 700; }\n\n   /* \u2500\u2500 INFO GRID \u2500\u2500 */\n   .info-grid {\n       display: grid;\n       grid-template-columns: repeat(3, 1fr);\n       border: 1.5px solid var(--border-navy);\n       border-radius: 8px;\n       overflow: hidden;\n       margin-bottom: 22px;\n       box-shadow: 0 2px 12px rgba(13,27,62,0.07);\n   }\n   .info-cell {\n       padding: 10px 14px;\n       border-right: 1px solid #CBD5E8;\n       border-bottom: 1px solid #CBD5E8;\n       background: var(--white);\n   }\n   .info-cell:nth-child(3), .info-cell:nth-child(6) { border-right: none; }\n   .info-cell:nth-child(4), .info-cell:nth-child(5), .info-cell:nth-child(6) { border-bottom: none; }\n   .info-cell.gold-bg { background: var(--gold-pale); }\n   .info-lbl {\n       font-size: 7.5px;\n       font-weight: 700;\n       text-transform: uppercase;\n       letter-spacing: 1.2px;\n       color: var(--gold-mid);\n       margin-bottom: 4px;\n   }\n   .info-val {\n       font-size: 11px;\n       font-weight: 600;\n       color: var(--navy-deep);\n   }\n   .info-val.red { color: #C0392B; }\n   .info-val.gold { color: var(--gold-deep); font-weight: 700; }\n\n   /* \u2500\u2500 BOOKING TABLE \u2500\u2500 */\n   .booking-wrap {\n       border: 1.5px solid var(--border-navy);\n       border-radius: 8px;\n       overflow: hidden;\n       box-shadow: 0 2px 16px rgba(13,27,62,0.08);\n   }\n   .table-head {\n       background: var(--navy-deep);\n       display: grid;\n       align-items: center;\n       padding: 0;\n   }\n   .th-cell {\n       padding: 10px 12px;\n       font-size: 8px;\n       font-weight: 700;\n       text-transform: uppercase;\n       letter-spacing: 1px;\n       color: var(--gold-stripe);\n       border-right: 1px solid rgba(212,168,67,0.2);\n   }\n   .th-cell:last-child { border-right: none; }\n\n   /* Item group */\n   .item-group { border-bottom: 1.5px solid var(--border-navy); }\n   .item-group:last-child { border-bottom: none; }\n\n   .item-header-row {\n       display: grid;\n       align-items: stretch;\n       background: var(--navy-pale);\n       border-bottom: 1px solid #CBD5E8;\n   }\n   .item-name-block {\n       padding: 10px 14px;\n       display: flex;\n       align-items: center;\n       gap: 12px;\n       border-right: 1px solid #CBD5E8;\n   }\n   .item-name-img {\n       width: 54px;\n       height: 44px;\n       object-fit: contain;\n       border: 1px solid var(--gold-light);\n       border-radius: 4px;\n       background: #fff;\n       padding: 2px;\n       flex-shrink: 0;\n   }\n   .no-img-box {\n       width: 54px;\n       height: 44px;\n       border: 1px dashed var(--gold-light);\n       border-radius: 4px;\n       display: flex;\n       align-items: center;\n       justify-content: center;\n       flex-shrink: 0;\n       background: #fff;\n   }\n   .no-img-box span { font-size: 7px; color: var(--gold-light); font-weight: 600; }\n   .item-name-text {\n       font-family: 'Playfair Display', serif;\n       font-size: 13px;\n       font-weight: 700;\n       color: var(--navy-deep);\n       text-transform: uppercase;\n       letter-spacing: 0.3px;\n   }\n   .item-name-sub {\n       font-size: 8px;\n       color: var(--text-muted);\n       font-weight: 500;\n       margin-top: 2px;\n       text-transform: uppercase;\n       letter-spacing: 0.5px;\n   }\n\n   /* Size rows */\n   .size-row {\n       display: grid;\n       align-items: center;\n       border-bottom: 1px solid #EEF2FA;\n       background: #fff;\n   }\n   .size-row:last-of-type { border-bottom: none; }\n   .size-row:nth-child(even) { background: #FAFBFE; }\n   .s-cell {\n       padding: 8px 12px;\n       border-right: 1px solid #EEF2FA;\n       font-size: 10px;\n   }\n   .s-cell:last-child { border-right: none; }\n   .s-lbl { font-size: 7px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 2px; }\n   .s-val { font-size: 10.5px; font-weight: 600; color: var(--navy-deep); }\n\n   /* Subtotal row */\n   .subtotal-row {\n       display: grid;\n       align-items: center;\n       background: var(--gold-pale);\n       border-top: 1px solid var(--gold-light);\n       border-bottom: 1px solid #CBD5E8;\n   }\n   .subtotal-label {\n       padding: 7px 14px;\n       font-size: 8.5px;\n       font-weight: 700;\n       color: var(--gold-deep);\n       text-transform: uppercase;\n       letter-spacing: 0.8px;\n       border-right: 1px solid var(--gold-light);\n   }\n   .subtotal-val {\n       padding: 7px 14px;\n       font-size: 12px;\n       font-weight: 800;\n       color: var(--navy-deep);\n       text-align: right;\n   }\n\n   /* Grand total */\n   .grand-total-row {\n       display: grid;\n       align-items: center;\n       background: var(--navy-deep);\n       border-top: 2px solid var(--gold-bright);\n   }\n   .gt-label {\n       padding: 12px 16px;\n       font-family: 'Playfair Display', serif;\n       font-size: 11px;\n       font-weight: 700;\n       color: var(--gold-stripe);\n       text-transform: uppercase;\n       letter-spacing: 1px;\n       border-right: 1px solid rgba(212,168,67,0.25);\n   }\n   .gt-value {\n       padding: 12px 16px;\n       font-family: 'Playfair Display', serif;\n       font-size: 16px;\n       font-weight: 800;\n       color: var(--gold-bright);\n       text-align: right;\n       letter-spacing: 0.5px;\n   }\n\n   /* Signature */\n   .sig-strip {\n       display: flex;\n       justify-content: space-between;\n       margin-top: 60px;\n   }\n   .sig-col {\n       width: 29%;\n       text-align: center;\n       padding-top: 10px;\n       border-top: 1.5px solid var(--gold-mid);\n   }\n   .sig-title {\n       font-size: 8px;\n       font-weight: 700;\n       text-transform: uppercase;\n       letter-spacing: 1.2px;\n       color: var(--gold-mid);\n   }\n   .sig-name {\n       font-size: 9.5px;\n       font-weight: 500;\n       color: var(--navy-deep);\n       margin-top: 3px;\n       line-height: 1.4;\n   }\n\n   /* Footer */\n   .doc-footer {\n       margin-top: 26px;\n       padding-top: 14px;\n       border-top: 1px solid var(--gold-light);\n       display: flex;\n       justify-content: space-between;\n       align-items: center;\n   }\n   .footer-brand { font-size: 9px; font-weight: 700; color: var(--gold-deep); text-transform: uppercase; letter-spacing: 2px; }\n   .footer-meta { font-size: 7.5px; color: var(--text-muted); margin-top: 3px; text-transform: uppercase; letter-spacing: 1px; }\n\n   @media print {\n       .page-wrap { page-break-before: always; page-break-inside: avoid; }\n       .page-wrap:first-of-type { page-break-before: avoid; }\n   }\n</style>\n\n{% set all_accessories = [\n   {'label': 'Button Booking',          'table': 'trim_details',                 'unit': 'Dzn',   'check': 'button',                    'show_image': false},\n   {'label': 'Elastic Booking',         'table': 'elastic_details',              'unit': 'Lbs',   'check': 'elastic',                   'show_image': false},\n   {'label': 'Button Poly Booking',     'table': 'button_poly_details',          'unit': 'Pcs',   'check': 'button_poly',               'show_image': false},\n   {'label': 'Zipper Booking',          'table': 'zipper_booking',               'unit': 'Pcs',   'check': 'zipper',                    'show_image': false},\n   {'label': 'Sewing Thread Booking',   'table': 'sewing_thread_booking',        'unit': 'Cones', 'check': 'sewing_thread',             'show_image': false},\n   {'label': 'Main Label Booking',      'table': 'main_label_details',           'unit': 'Pcs',   'check': 'main_label',                'show_image': true},\n   {'label': 'Main Label With Size',    'table': 'main_label_with_size_details', 'unit': 'Pcs',   'check': 'main_label_with_size',      'show_image': true},\n   {'label': 'Care Label With Barcode', 'table': 'care_label_with_barcode',      'unit': 'Pcs',   'check': 'cl_with_barcode',           'show_image': true},\n   {'label': 'Care Label W/O Barcode',  'table': 'care_label_wo_barcode',        'unit': 'Pcs',   'check': 'care_label_without_barcode','show_image': true},\n   {'label': 'Price Tag Booking',       'table': 'price_tag_quantity',           'unit': 'Pcs',   'check': 'price_tag',                 'show_image': true},\n   {'label': 'Price Tag Sticker',       'table': 'price_tag_sticker_quantity',   'unit': 'Pcs',   'check': 'price_tag_sticker',         'show_image': true},\n   {'label': 'Hand Tag Booking',        'table': 'hand_tag_details',             'unit': 'Pcs',   'check': 'hand_tag',                  'show_image': true},\n   {'label': 'Additional Tag Booking',  'table': 'additional_tag_details',       'unit': 'Pcs',   'check': 'additional_tag',            'show_image': true},\n   {'label': 'Hang Tag String',         'table': 'hand_tag_string_details',      'unit': 'Pcs',   'check': 'hang_tag_string',           'show_image': false},\n   {'label': 'Poly Booking',            'table': 'poly_details',                 'unit': 'Pcs',   'check': 'poly',                      'show_image': false},\n   {'label': 'Blister Booking',         'table': 'blister_details',              'unit': 'Pcs',   'check': 'blister',                   'show_image': false},\n   {'label': 'Carton Booking',          'table': 'cartoon_details',              'unit': 'Pcs',   'check': 'cartoon',                   'show_image': false},\n   {'label': 'Carton Sticker',          'table': 'cartoon_sticker_details',      'unit': 'Pcs',   'check': 'cartoon_sticker',           'show_image': false},\n   {'label': 'Gum Tape Booking',        'table': 'gum_tape_details',             'unit': 'Roll',  'check': 'gum_tape',                  'show_image': false},\n   {'label': 'Gum Tape (Red)',          'table': 'gum_tape_red',                 'unit': 'Roll',  'check': 'gum_tape_red',               'show_image': false},\n   {'label': 'Gum Tape (Green)',        'table': 'gum_tape_green',               'unit': 'Roll',  'check': 'gum_tape_green',             'show_image': false}\n] %}\n\n{% set page_counter = [0] %}\n\n{% for accessory in all_accessories %}\n{% set rows = doc[accessory.table] if doc[accessory.table] is iterable and doc[accessory.table] is not string and doc[accessory.table] is not number else [] %}\n{% if doc[accessory.check] == 1 and rows %}\n{% set _ = page_counter.append(1) %}\n\n<div class=\"page-wrap\" style=\"page-break-before: {{ 'avoid' if page_counter|length == 2 else 'always' }};\">\n\n   <div style=\"margin-bottom: 18px;\">{{ letter_head }}</div>\n\n   <div class=\"doc-header\">\n       <div class=\"title-block\">\n           <div class=\"title-accent\"></div>\n           <div>\n               <div class=\"doc-title\">{{ accessory.label }}</div>\n               <div class=\"doc-subtitle\">Official Procurement Sheet &nbsp;\u00b7&nbsp; Meek Sweater &amp; Fashions Ltd.</div>\n               <div class=\"doc-id-chip\">{{ doc.name }}</div>\n           </div>\n       </div>\n       <div class=\"badge-block\">\n           <div class=\"supplier-badge\">&#9670; Supplier Copy &#9670;</div>\n           <div class=\"sdo-text\">SDO: <span>{{ doc.sdo_number or 'N/A' }}</span></div>\n           <div class=\"sdo-text\" style=\"margin-top:3px;\">SSO: <span>{{ doc.sso_number or 'N/A' }}</span></div>\n       </div>\n   </div>\n\n   <div class=\"info-grid\">\n       <div class=\"info-cell gold-bg\">\n           <div class=\"info-lbl\">Date</div>\n           <div class=\"info-val\">{{ frappe.utils.formatdate(doc.posting_date or doc.creation, \"dd-MMM-yyyy\") }}</div>\n       </div>\n       <div class=\"info-cell gold-bg\">\n           <div class=\"info-lbl\">Buyer</div>\n           <div class=\"info-val\">{{ doc.buyer or 'N/A' }}</div>\n       </div>\n       <div class=\"info-cell gold-bg\">\n           <div class=\"info-lbl\">Season</div>\n           <div class=\"info-val gold\">{{ doc.season or '\u2014' }}</div>\n       </div>\n       <div class=\"info-cell\">\n           <div class=\"info-lbl\">Style Name</div>\n           <div class=\"info-val\">{{ doc.style_name or '\u2014' }}</div>\n       </div>\n       <div class=\"info-cell\">\n           <div class=\"info-lbl\">Supplier</div>\n           <div class=\"info-val red\">{{ (doc.label_supplier or doc.supplier or 'N/A')|upper }}</div>\n       </div>\n       <div class=\"info-cell\">\n           <div class=\"info-lbl\">Garments Qty</div>\n           <div class=\"info-val gold\">{{ \"{:,}\".format(doc.sweater_quantity|int) }} Pcs</div>\n       </div>\n       <div class=\"info-cell\">\n           <div class=\"info-lbl\">Ref. LC / PI</div>\n           <div class=\"info-val\">{{ doc.lc_number or doc.reference_pi_no or 'Contract' }}</div>\n       </div>\n       <div class=\"info-cell\">\n           <div class=\"info-lbl\">Payment Term</div>\n           <div class=\"info-val\">{{ doc.payment_term or '\u2014' }}</div>\n       </div>\n       <div class=\"info-cell\">\n           <div class=\"info-lbl\">Attention</div>\n           <div class=\"info-val\">{{ doc.attention_name or 'Production Manager' }}</div>\n       </div>\n   </div>\n\n   {% set show_img = accessory.show_image %}\n\n   {% if show_img %}\n       {% set grid_hdr = \"40px 70px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set grid_item = \"40px 70px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set grid_size = \"40px 70px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set grid_sub  = \"40px 70px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set gt_span_cols = \"40px 70px 1fr 80px 80px 70px\" %}\n   {% else %}\n       {% set grid_hdr = \"40px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set grid_item = \"40px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set grid_size = \"40px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set grid_sub  = \"40px 1fr 80px 80px 70px 70px 110px\" %}\n       {% set gt_span_cols = \"40px 1fr 80px 80px 70px\" %}\n   {% endif %}\n\n   <div class=\"booking-wrap\">\n       <div class=\"table-head\" style=\"grid-template-columns: {{ grid_hdr }};\">\n           <div class=\"th-cell\" style=\"text-align:center;\">#</div>\n           <div class=\"th-cell\" style=\"text-align:center;\"></div>\n           {% if show_img %}<div class=\"th-cell\" style=\"text-align:center;\">Image</div>{% endif %}\n           <div class=\"th-cell\" style=\"text-align:center;\">Size</div>\n           <div class=\"th-cell\" style=\"text-align:center;\">Qty (Pcs)</div>\n           <div class=\"th-cell\" style=\"text-align:center;\">Cons</div>\n           <div class=\"th-cell\" style=\"text-align:center;\">Waste %</div>\n           <div class=\"th-cell\" style=\"text-align:right;\">Booking Qty</div>\n       </div>\n\n       {% set seen_items = [] %}\n       {% set grand_total = [0] %}\n       {% set sl = [0] %}\n\n       {% for row in rows %}\n       {% if row.trim_name not in seen_items %}\n       {% set _ = seen_items.append(row.trim_name) %}\n       {% set _ = sl.append(1) %}\n\n           {% set item_rows = [] %}\n           {% for r in rows %}\n               {% if r.trim_name == row.trim_name %}{% set _ = item_rows.append(r) %}{% endif %}\n           {% endfor %}\n\n           {% set item_total = [0] %}\n           {% for r in item_rows %}\n               {% set _ = item_total.append(r.total_trim_required | float) %}\n               {% set _ = grand_total.append(r.total_trim_required | float) %}\n           {% endfor %}\n\n           <div class=\"item-group\">\n               <div class=\"item-header-row\" style=\"grid-template-columns: {{ grid_item }};\">\n                   <div style=\"display:flex; align-items:center; justify-content:center; padding:10px 8px; border-right:1px solid #CBD5E8; font-family:'Playfair Display',serif; font-size:16px; font-weight:700; color:var(--gold-mid);\">\n                       {{ sl|length - 1 }}\n                   </div>\n\n                   {% if show_img %}\n                   <div style=\"display:flex; align-items:center; justify-content:center; padding:8px; border-right:1px solid #CBD5E8;\">\n                       {% if row.attach_file %}\n                           <img src=\"{{ row.attach_file }}\" class=\"item-name-img\">\n                       {% else %}\n                           <div class=\"no-img-box\"><span>NO IMG</span></div>\n                       {% endif %}\n                   </div>\n                   {% endif %}\n\n                   <div style=\"padding:10px 16px; display:flex; flex-direction:column; justify-content:center; border-right:1px solid #CBD5E8; grid-column: span {{ '6' if not show_img else '6' }};\">\n                       <div class=\"item-name-text\">{{ row.trim_name or '\u2014' }}</div>\n                       \n                       <div class=\"item-name-sub\">{{ item_rows|length }} size{{ 's' if item_rows|length > 1 else '' }} &nbsp;\u00b7&nbsp; Total: {{ \"{:,.2f}\".format(item_total|sum) }} {{ accessory.unit }}</div>\n                   </div>\n               </div>\n\n               {% for r in item_rows %}\n               <div class=\"size-row\" style=\"grid-template-columns: {{ grid_size }};\">\n                   <div class=\"s-cell\" style=\"text-align:center; background:var(--navy-pale); border-right:1px solid #EEF2FA;\"></div>\n                   {% if show_img %}<div class=\"s-cell\" style=\"border-right:1px solid #EEF2FA;\"></div>{% endif %}\n                   <div class=\"s-cell\" style=\"padding-left:28px; border-right:1px solid #EEF2FA;\">\n                       <div class=\"s-lbl\"></div>\n                       <div class=\"s-val\" style=\"color:var(--navy-mid);\"></div>\n                   </div>\n                   <div class=\"s-cell\" style=\"padding-left:28px; border-right:1px solid #EEF2FA;\">\n                       <div class=\"s-lbl\">Size</div>\n                       <div class=\"s-val\" style=\"color:var(--navy-mid);\">{{ r.size or '\u2014' }}</div>\n                   </div>\n                   <div class=\"s-cell\" style=\"text-align:center; border-right:1px solid #EEF2FA;\">\n                       <div class=\"s-lbl\">Qty</div>\n                       <div class=\"s-val\">{{ \"{:,}\".format(r.quantity|int) }}</div>\n                   </div>\n                   <div class=\"s-cell\" style=\"text-align:center; border-right:1px solid #EEF2FA;\">\n                       <div class=\"s-lbl\">Cons</div>\n                       <div class=\"s-val\">{{ r.consumption or '1' }}</div>\n                   </div>\n                   <div class=\"s-cell\" style=\"text-align:center; border-right:1px solid #EEF2FA;\">\n                       <div class=\"s-lbl\">Waste</div>\n                       <div class=\"s-val\">{{ r.wastage or '0' }}%</div>\n                   </div>\n                   <div class=\"s-cell\" style=\"text-align:right; background:var(--gold-pale);\">\n                       <div class=\"s-lbl\">Booking Qty</div>\n                       <div class=\"s-val\" style=\"color:var(--navy-deep); font-weight:700; font-size:11px;\">{{ \"{:,.2f}\".format(r.total_trim_required|float) }}</div>\n                   </div>\n               </div>\n               {% endfor %}\n\n               <div style=\"display:grid; grid-template-columns:{{ gt_span_cols }} 70px 110px; background:var(--gold-pale); border-top:1px solid var(--gold-light);\">\n                   <div style=\"padding:7px 16px; font-size:8.5px; font-weight:700; color:var(--gold-deep); text-transform:uppercase; letter-spacing:0.8px; grid-column:1/{% if show_img %}8{% else %}7{% endif %}; border-right:1px solid var(--gold-light);\">\n                       &#9670; Subtotal \u2014 {{ row.trim_name }}\n                   </div>\n                   <div style=\"padding:7px 14px; font-size:12px; font-weight:800; color:var(--navy-deep); text-align:right;\">\n                       {{ \"{:,.2f}\".format(item_total|sum) }} <span style=\"font-size:9px; font-weight:600; color:var(--gold-mid);\">{{ accessory.unit }}</span>\n                   </div>\n               </div>\n           </div>\n       {% endif %}\n       {% endfor %}\n\n       <div style=\"display:grid; grid-template-columns: 1fr 200px; background:var(--navy-deep); border-top:2px solid var(--gold-bright);\">\n           <div style=\"padding:14px 18px; font-family:'Playfair Display',serif; font-size:12px; font-weight:700; color:var(--gold-stripe); text-transform:uppercase; letter-spacing:1px; border-right:1px solid rgba(212,168,67,0.3);\">\n               &#9670; Grand Total \u2014 {{ accessory.label }}\n           </div>\n           <div style=\"padding:14px 18px; font-family:'Playfair Display',serif; font-size:18px; font-weight:800; color:var(--gold-bright); text-align:right; letter-spacing:0.5px;\">\n               {{ \"{:,.2f}\".format(grand_tot