 "font_size": 14,
 "html": "<style>\n@page { size: A4 landscape; margin: 10mm; }\nbody { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 11px; color: #111; }\ntable { width: 100%; border-collapse: collapse; }\ntd, th { border: 1px solid #222; padding: 4px 6px; vertical-align: middle; font-size:11px; }\nth { font-size: 10.5px; text-transform: uppercase; background: #f2f4f7; }\n.center { text-align: center; } .right { text-align: right; } \n.h50 { height: 50px; } .h70 { height: 70px; }\n.signature { height: 46px; border-bottom: 1px solid #000; margin-bottom: 4px; }\n.qr-code { width: 60px; height: 60px; border: 1px solid #ccc; border-radius: 6px; padding: 2px; }\nhr { border: 0; border-top: 1px dashed #ccc; margin:2px 0; }\n.yarn { font-size: 9px; line-height: 1.1; } /* Smaller yarn composition */\n.subtle { font-size: 9px; color: #444; }\n</style>\n\n<!-- LETTERHEAD -->\n<div class=\"letter-head\">{{ letter_head }}</div>\n<br>\n\n{% set doc_id = doc.name.strip() if doc.name else \"\" %}\n<div class=\"right subtle\" style=\"margin-bottom:5px;\">\n    Form No: {{ doc_id[-5:] if doc_id|length >= 5 else doc_id }}\n</div>\n\n<!-- CALCULATE TOTAL YARN SAFELY -->\n{% set total_yarn = 0.0 %}\n{% if doc.raw_material %}\n    {% for yarn in doc.raw_material %}\n        {% set qty = 0.0 %}\n        {% if yarn.quantity %}\n            {% set qty = yarn.quantity|string|replace(',', '')|float(0) %}\n        {% endif %}\n        {% set total_yarn = total_yarn + qty %}\n    {% endfor %}\n{% endif %}\n\n<!-- HEADER -->\n<table class=\"header\">\n<tr>\n    <td width=\"33%\">Buyer: {{ doc.buyer or \"\" }}</td>\n    <td width=\"34%\">Attention: {{ doc.designer or \"\" }}</td>\n    <td width=\"33%\">Date: {{ frappe.utils.formatdate(doc.requested_time, \"dd-MMM-yyyy\") if doc.requested_time else \"\" }}</td>\n</tr>\n<tr>\n    <td>Sample Type: {{ doc.sample_type or \"\" }}</td>\n    <td><b>Delivered Yarn Qty (KG):</b> {{ \"%.2f\"|format(total_yarn) }}</td>\n    <td>Yarn Delivery Time: {{ frappe.utils.now_datetime() }}</td>\n</tr>\n\n</table>\n\n<br>\n\n<!-- MAIN TABLE -->\n<table>\n<tr class=\"center\">\n    <th width=\"4%\">SL</th>\n    <th width=\"12%\">Style / Ref</th>\n    <th width=\"21%\">Description</th>\n    <th width=\"34%\">Yarn Composition</th>\n    <th width=\"6%\">Gauge</th>\n    <th width=\"10%\">Size</th>\n    <th width=\"8%\">Qty</th>\n    <th width=\"14%\">Remarks</th>\n</tr>\n\n{% if doc.sample_request_quantity|length > 0 %}\n    {% for idx, row in enumerate(doc.sample_request_quantity) %}\n    <tr>\n        <td class=\"center h50\">{{ idx + 1 }}</td>\n        <td class=\"h50\">{{ doc.style or \"\" }}</td>\n\n        <!-- REFERENCE IMAGE -->\n        <td class=\"h50\">\n            {% if doc.reference_image %}\n                <img src=\"{{ doc.reference_image }}\" style=\"max-width:100%; max-height:89px;\">\n            {% else %}\n                No Image\n            {% endif %}\n        </td>\n\n        <!-- YARN COMPOSITION: compact, small font, skip Required By -->\n        <td class=\"h50 yarn\">\n            {% if doc.raw_material %}\n                {% for yarn in doc.raw_material %}\n                    {{ yarn.yarn_composition or \"\" }} {{ yarn.yarn_count or \"\" }}{% if yarn.colour %} - {{ yarn.colour }}{% endif %} : {{ yarn.quantity|string|replace(',', '')|float(0)|round(2) }} KG\n                    {% if not loop.last %}<hr/>{% endif %}\n                {% endfor %}\n            {% else %}\n                No Yarn Info\n            {% endif %}\n        </td>\n\n        <td class=\"center h50\">{{ doc.gauge or \"\" }}</td>\n        <td class=\"h50\">{{ row.size or \"\" }}</td>\n        <td class=\"center h50\">{{ row.quantity|string|replace(',', '')|float(0) }}</td>\n        <td class=\"h50\">{{ row.remarks or \"\" }}</td>\n    </tr>\n    {% endfor %}\n{% else %}\n<tr>\n    <td colspan=\"9\" class=\"center\">No Quantity Rows Found</td>\n</tr>\n{% endif %}\n</table>\n\n<br><br>\n\n<!-- SIGNATURE -->\n<table style=\"border:none;\">\n<tr>\n    <td style=\"border:none;text-align:center;\"><div class=\"signature\"></div>Designer</td>\n    <td style=\"border:none;text-align:center;\"><div class=\"signature\"></div>Technical Manager</td>\n    <td style=\"border:none;text-align:center;\"><div class=\"signature\"></div>Merchandiser</td>\n    <td style=\"border:none;text-align:center;\"><div class=\"signature\"></div>Managing Director</td>\n</tr>\n</table>\n\n<br>\n\n<div style=\"display:flex; justify-content:flex-end; gap:10px; font-size:10px;\">\n    <div>Printed: {{ frappe.utils.now_datetime() }}</div>\n    <div>\n        <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=80x80&data={{ frappe.utils.get_url() }}/app/daily-sample-request/{{ doc.name }}\" class=\"qr-code\">\n    </div>\n</div>",
